<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/hello" style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سلام 👋"/>
            <TextView style="@style/H1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بک‌آپ تلگرام"/>
        </LinearLayout>
        <com.google.android.material.chip.Chip android:id="@+id/connChip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="متصل" app:chipIcon="@drawable/ic_check" app:chipIconTint="@color/ok" android:clickable="false"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_hero"
        android:padding="22dp" android:gravity="center_vertical">
        <FrameLayout android:layout_width="120dp" android:layout_height="120dp">
            <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/ring"
                android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000"
                app:indicatorSize="120dp" app:trackThickness="11dp" app:indicatorColor="#FFFFFF" app:trackColor="#40FFFFFF" app:trackCornerRadius="6dp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0٪" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="امن شده" android:textColor="#D9FFFFFF" android:textSize="12sp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="18dp">
            <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="…" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/heroSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#E6FFFFFF" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/runCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView style="@style/H2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="⏫ در حال بک‌آپ"/>
                <TextView android:id="@+id/runCount" style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/runBar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp" app:trackThickness="8dp" app:trackCornerRadius="4dp"/>
            <TextView android:id="@+id/runText" style="@style/Sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnStop" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="توقف" app:icon="@drawable/ic_stop" android:textColor="@color/danger" app:iconTint="@color/danger"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁️" android:textSize="20sp"/>
                <TextView android:id="@+id/stBacked" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
                <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بک‌آپ‌شده"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="20sp"/>
                <TextView android:id="@+id/stLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
                <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="در انتظار"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧹" android:textSize="20sp"/>
                <TextView android:id="@+id/stFree" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
                <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="قابل آزادسازی"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎉" android:textSize="20sp"/>
                <TextView android:id="@+id/stFreed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="—" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text"/>
                <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فضای آزادشده"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnBackupAll" style="@style/BigBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="بک‌آپ همه موارد جدید" app:icon="@drawable/ic_cloud_up" app:iconGravity="textStart"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnFree" style="@style/BigBtn.Tonal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="آزادسازی فضای گوشی" app:icon="@drawable/ic_delete" app:iconGravity="textStart"/>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📜 تاریخچه"/>
            <TextView android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:lineSpacingExtra="6dp" android:textSize="13sp" android:textColor="@color/text2" android:text="هنوز چیزی نیست"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
