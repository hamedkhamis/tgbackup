<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="گالری"/>
                <TextView android:id="@+id/gCount" style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAlbum" style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="همه پوشه‌ها" app:icon="@drawable/ic_folder" android:maxWidth="180dp" android:ellipsize="end" android:maxLines="1"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp">
                <com.google.android.material.chip.ChipGroup android:id="@+id/stateGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
                    <com.google.android.material.chip.Chip android:id="@+id/fAll" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="همه" android:checked="true"/>
                    <com.google.android.material.chip.Chip android:id="@+id/fPending" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بک‌آپ نشده"/>
                    <com.google.android.material.chip.Chip android:id="@+id/fDone" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بک‌آپ شده ☁️"/>
                </com.google.android.material.chip.ChipGroup>
                <com.google.android.material.chip.ChipGroup android:id="@+id/typeGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
                    <com.google.android.material.chip.Chip android:id="@+id/tAll" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عکس و ویدئو" android:checked="true"/>
                    <com.google.android.material.chip.Chip android:id="@+id/tPhoto" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🖼 عکس"/>
                    <com.google.android.material.chip.Chip android:id="@+id/tVideo" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎬 ویدئو"/>
                    <com.google.android.material.chip.Chip android:id="@+id/tBig" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦 حجیم‌ترین"/>
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="6dp" android:clipToPadding="false" android:paddingBottom="110dp"/>
    </LinearLayout>

    <TextView android:id="@+id/gEmpty" style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="موردی پیدا نشد" android:visibility="gone"/>

    <com.google.android.material.card.MaterialCardView android:id="@+id/selBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="12dp" android:visibility="gone"
        app:cardElevation="10dp" app:cardBackgroundColor="@color/brand_deep" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageButton android:id="@+id/selClose" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/ic_close" app:tint="#FFFFFF"/>
                <TextView android:id="@+id/selCount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                <ImageButton android:id="@+id/selAll" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/ic_select_all" app:tint="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/selBackup" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="بک‌آپ" app:icon="@drawable/ic_cloud_up"
                    app:backgroundTint="#FFFFFF" android:textColor="@color/brand_deep" app:iconTint="@color/brand_deep"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/selDelete" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="حذف از گوشی" app:icon="@drawable/ic_delete"
                    app:backgroundTint="@color/danger"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
