<?xml version="1.0" encoding="utf-8"?>
<ir.hamed.tgbackup.SquareFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2dp">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:background="@color/stroke" app:shapeAppearance="@style/Round"/>
    <View android:id="@+id/selOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/sel_overlay" android:visibility="gone"/>
    <ImageView android:id="@+id/check" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:layout_margin="6dp"
        android:background="@drawable/bg_badge" android:backgroundTint="@color/brand" android:padding="3dp" android:src="@drawable/ic_check" app:tint="#FFFFFF" android:visibility="gone"/>
    <ImageView android:id="@+id/cloud" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" android:layout_margin="6dp"
        android:background="@drawable/bg_badge" android:padding="4dp" android:src="@drawable/ic_cloud_up" app:tint="#FFFFFF" android:visibility="gone"/>
    <TextView android:id="@+id/dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="6dp"
        android:background="@drawable/bg_pill" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
        android:textColor="#FFFFFF" android:textSize="11sp" android:visibility="gone"/>
</ir.hamed.tgbackup.SquareFrame>
